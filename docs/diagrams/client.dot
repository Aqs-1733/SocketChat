digraph G {
 graph [rankdir=TB,bgcolor="white", nodesep=.22, ranksep=.36, pad=.18];
 node [shape=box,style=rounded,fontname="Noto Sans CJK SC",fontsize=12,color="#303030",margin="0.17,0.09"];
 edge [color="#404040",arrowsize=.7];
 a[label="WSAStartup + socket"]; b[label="connect 建立 TCP 连接"];c[label="发送 JOIN / 等待 WELCOME"];d[label="CreateThread 建立接收线程"];e[label="主线程读取用户输入"];f[shape=diamond,label="命令类型"];g[label="TEXT|seq|正文 / WHO"];h[label="QUIT / 半关闭发送端"];i[label="接收线程 recv / 分帧 / UTF-8 显示"];j[label="关闭连接与清理资源"];
 a->b->c->d;d->e;d->i; e->f;f->g[label="聊天 / 查询"];g->e;f->h[label="退出"];h->j;i->j[style=dashed,label="连接结束"];
}
