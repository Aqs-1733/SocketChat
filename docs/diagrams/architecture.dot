digraph G {
 graph [rankdir=LR, bgcolor="white", nodesep=.38, ranksep=.68, pad=.2];
 node [shape=box,style="rounded",fontname="Noto Sans CJK SC", fontsize=13, color="#303030", margin="0.20,0.13"];
 edge [color="#404040",arrowsize=.8];
 A [label="客户端 Alice\n输入线程 + 接收线程"];
 B [label="客户端 Bob\n输入线程 + 接收线程"];
 C [label="客户端 Charlie\n输入线程 + 接收线程"];
 S [label="TCP 服务器\n监听线程 + 每连接处理线程\n在线用户表 + 广播 + 时间戳", penwidth=1.7];
 {rank=same; A; B; C}
 A -> S [dir=both,label="TCP"];
 B -> S [dir=both,label="TCP"];
 C -> S [dir=both,label="TCP"];
}
